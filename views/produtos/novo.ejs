<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Novo Produto - Cadastro de Produtos</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

  <nav class="navbar">
    <a href="/produtos" class="brand">Loja MVC</a>
    <div class="nav-links">
      <a href="/produtos">Produtos</a>
      <a href="/produtos/novo">+ Novo Produto</a>
      <a href="/categorias">Categorias</a>
      <a href="/categorias/nova">+ Nova Categoria</a>
    </div>
  </nav>

  <main class="container">
    <div class="card" style="max-width: 600px; margin: 2rem auto;">
      <div class="page-header">
        <h1>Novo Produto</h1>
      </div>

      <form action="/produtos" method="POST">
        <div class="form-group">
          <label for="nome">Nome do Produto:</label>
          <input type="text" id="nome" name="nome" placeholder="Ex: Teclado Mecânico" required>
        </div>

        <div class="form-group">
          <label for="categoriaId">Categoria:</label>
          <select id="categoriaId" name="categoriaId">
            <option value="">-- Selecione uma Categoria --</option>
            <% categorias.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.nome %></option>
            <% }) %>
          </select>
          <small style="color: #64748b; display: block; margin-top: 0.25rem;">
            Precisa de uma nova categoria? <a href="/categorias/nova" style="color: #2563eb;">Cadastre aqui</a>.
          </small>
        </div>

        <div class="form-group">
          <label for="preco">Preço (R$):</label>
          <input type="number" id="preco" name="preco" step="0.01" min="0" placeholder="0.00" required>
        </div>

        <div class="form-group">
          <label for="quantidade">Quantidade em Estoque:</label>
          <input type="number" id="quantidade" name="quantidade" min="0" value="0" required>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Salvar Produto</button>
          <a href="/produtos" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </main>

</body>
</html>
