<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Categorias - Cadastro de Produtos</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

  <nav class="navbar">
    <a href="/produtos" class="brand">Loja MVC</a>
    <div class="nav-links">
      <a href="/produtos">Produtos</a>
      <a href="/produtos/novo">+ Novo Produto</a>
      <a href="/categorias">Categorias</a>
      <a href="/categorias/nova">+ Nova Categoria</a>
    </div>
  </nav>

  <main class="container">
    <div class="card">
      <div class="page-header">
        <h1>Categorias</h1>
        <a href="/categorias/nova" class="btn btn-primary">+ Nova Categoria</a>
      </div>

      <% if (categorias.length === 0) { %>
        <div class="empty-state">
          <p>Nenhuma categoria cadastrada até o momento.</p>
          <a href="/categorias/nova" class="btn btn-primary">Cadastrar Primeira Categoria</a>
        </div>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Nome da Categoria</th>
              <th>Qtd. de Produtos</th>
              <th style="text-align: right;">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% categorias.forEach(c => { %>
              <tr>
                <td>#<%= c.id %></td>
                <td><strong><%= c.nome %></strong></td>
                <td><%= c.produtos ? c.produtos.length : 0 %> produto(s)</td>
                <td style="text-align: right;">
                  <div class="actions-cell" style="justify-content: flex-end;">
                    <a href="/produtos/categoria/<%= c.id %>" class="btn btn-secondary btn-sm">
                      Ver Produtos
                    </a>
                    <form action="/categorias/<%= c.id %>/deletar" method="POST" onsubmit="return confirm('Deseja realmente excluir esta categoria? Os produtos associados ficarão sem categoria.');">
                      <button type="submit" class="btn btn-danger btn-sm">
                        Excluir
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>

</body>
</html>
